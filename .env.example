# Database connection. SQLite for local dev; for production use a hosted
# Postgres (e.g. Supabase, Neon) and change the provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Secret used to sign admin session cookies. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=""

# Admin login credentials for the /admin panel.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Agency name shown across the public job board and admin panel.
NEXT_PUBLIC_AGENCY_NAME="Your Agency"
