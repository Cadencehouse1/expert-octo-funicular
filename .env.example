# PostgreSQL connection string. For local dev use a local Postgres or a
# free hosted database (e.g. Neon). On Vercel this is set automatically
# when you attach a Neon database to the project.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Secret used to sign admin session cookies. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=""

# Admin login credentials for the /admin panel.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Agency name shown across the public job board and admin panel.
NEXT_PUBLIC_AGENCY_NAME="Cadence House"
